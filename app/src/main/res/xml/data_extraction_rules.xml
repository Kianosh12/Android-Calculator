<?xml version="1.0" encoding="utf-8"?>
<!--
   No cloud backup / device transfer rules; the calculator keeps no user data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
